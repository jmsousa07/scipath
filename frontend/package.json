{
  "name": "scipath-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "tokens": "node scripts/extract-tokens.mjs && node scripts/extract-fonts.mjs && node scripts/extract-ds-layer.mjs",
    "check:tokens": "node scripts/extract-tokens.mjs --check && node scripts/extract-fonts.mjs --check && node scripts/extract-ds-layer.mjs --check",
    "check:style": "node scripts/check-style.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "check:states": "node scripts/check-states.mjs",
    "check:sessao": "node scripts/check-sessao.mjs",
    "check:erros-sessao": "node --import ./scripts/ts-registrar.mjs scripts/check-erros-sessao.mjs",
    "check:perfil": "node scripts/check-perfil.mjs",
    "check:perfil-erros": "node --import ./scripts/ts-registrar.mjs scripts/check-perfil-erros.mjs",
    "check:publicar": "node scripts/check-publicar.mjs",
    "check:publicar-erros": "node --import ./scripts/ts-registrar.mjs scripts/check-publicar-erros.mjs",
    "verify": "npm run check:tokens && npm run check:style && npm run check:layout && npm run typecheck && npm run lint && npm run check:erros-sessao && npm run check:perfil-erros && npm run check:publicar-erros && npm run build && npm run check:states"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}