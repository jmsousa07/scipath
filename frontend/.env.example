# Copie para `.env.local` (não versionado) quando precisar mudar o padrão.
# O build NÃO depende destes valores: sem eles, o frontend usa os padrões de
# desenvolvimento abaixo. Nada de segredo aqui — frontend só lê o que é público.

# URL canônica usada em <link rel="canonical"> e nos metadados (RNF023/RNF025).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base da API do backend (a fronteira é contracts/openapi.yaml). Ainda não usada:
# nenhuma chamada de API entra na Etapa 1 (fora de escopo do card E1.6).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api