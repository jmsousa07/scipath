# Copie para .env e preencha — ou simplesmente rode `bash infra/db-setup.sh`,
# que cria o banco e gera este arquivo com senha aleatória.
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/scipath
SPRING_DATASOURCE_USERNAME=scipath
SPRING_DATASOURCE_PASSWORD=coloque-a-senha-aqui
SPRING_DATASOURCE_URL_TEST=jdbc:postgresql://127.0.0.1:5432/scipath_test
API_BASE_URL=http://localhost:8080/api

# Limite de upload em bytes (ou na forma legível, ex. 30MB) — ADR-0005 §1, card E4.2.
# 30 MB é o valor fixado para o MVP; mudar é trocar esta linha, sem recompilar.
SCIPATH_UPLOAD_MAX_BYTES=30MB

# Área temporária de recebimento do arquivo (opcional). Padrão:
# ${user.home}/.scipath/upload-temporario — fora do repositório e fora de qualquer
# diretório servido. Aponte para outro lugar só se precisar.
# SCIPATH_UPLOAD_DIR_TEMPORARIO=/caminho/absoluto/fora/do/repositorio

# Armazenamento DEFINITIVO do arquivo publicado (opcional, card E4.3). Padrão:
# ${user.home}/.scipath/arquivos — fora do repositório e fora de qualquer diretório
# servido: o arquivo só sai por GET /materiais/{slug}/arquivo, que decide visibilidade
# e autorização no servidor (RF014, ADR-0005 §2). A API RECUSA a subida se este caminho
# cair sob uma raiz servida (resources/static, frontend/public, ...).
# SCIPATH_STORAGE_DIR=/caminho/absoluto/fora/do/repositorio

