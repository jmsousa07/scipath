<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.scipath</groupId>
  <artifactId>scipath-backend</artifactId>
  <version>0.1.0</version>
  <name>scipath-backend</name>
  <description>API do SciPath — plataforma de descoberta e compartilhamento de conhecimento científico e acadêmico (DRS §2.1)</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <!-- Validação de entrada no servidor: sem ela o @Valid dos DTOs é ignorado em
         silêncio e a violação só aparece como 500. Exigida por RNF011 ("validar no
         servidor para segurança") e §14.3 ("validar entradas e produzir erros
         consistentes"). Toda dependência nova precisa de requisito (AGENTS.md). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Hash de senha: bcrypt custo 12 (ADR-0003 (a), card E3.2). Vem de
         `spring-security-crypto` e NÃO de `spring-boot-starter-security`: o ADR fixa só o
         algoritmo de hash, e o starter traria a cadeia de filtros de autenticação inteira —
         sessão e CSRF são do card E3.3, e um filtro ligado sem requisito muda o
         comportamento de todas as rotas existentes (§14.2: sem dependência nova sem
         necessidade demonstrada). A versão é a gerenciada pelo parent do Spring Boot. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>

    <!-- Flyway: schema versionado por migração imutável (ver AGENTS.md). A estratégia
         tolerante de falha de migração é só de dev/test — ver FlywayConfig. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- A suíte roda no perfil 'test' (ADR-0004, ajuste 3): é o perfil em que a
               migração tolera falha na subida — a máquina tem 954 MB e, sob pressão de
               memória, o Hikari deixa de obter conexão em 2 s (medido em 2026-10-16),
               o que não é motivo para reprovar teste que não é de schema. É também onde
               o card E1.5 declarar o datasource de scipath_test
               (src/test/resources/application-test.yml). Sem perfil, a suíte herdaria o
               fail-fast e um Postgres fora do ar derrubaria até o teste de /api/health,
               que existe justamente para tolerar banco fora. -->
          <systemPropertyVariables>
            <spring.profiles.active>test</spring.profiles.active>
          </systemPropertyVariables>
          <!-- Locale do fork dos testes (card E4.8-f1, DRS §17.5). A JVM deriva
               sun.jnu.encoding do locale do PROCESSO: um shell sem LANG (o 'env -i' do
               critério E1.5) sobe com ANSI_X3.4-1968 e aí um Path com nome não-ASCII não
               é representável — ArmazenamentoLocalTest.nomeOriginalNaoDecideOCaminho
               reprovava com InvalidPathException mesmo sem defeito nenhum no produto. O
               resultado da suíte não pode ser decidido pelo ambiente de quem rodou, então
               o locale é fixado aqui, onde a JVM dos testes nasce — e não no Makefile, que
               cobre só um dos modos de rodar (vale igual para ./mvnw -o test e para a IDE,
               como o perfil acima). C.UTF-8 é o locale em que a suíte de 226 testes está
               verde nesta máquina (medido 2026-10-19, shell sem LANG). -->
          <environmentVariables>
            <LANG>C.UTF-8</LANG>
            <LC_ALL>C.UTF-8</LC_ALL>
          </environmentVariables>
          <!-- Heap limitado no fork do surefire: a máquina tem 954 MB e roda o Maven
               (MAVEN_OPTS=-Xmx384m) e a JVM dos testes ao mesmo tempo (AGENTS.md —
               higiene de recursos). TieredStopAtLevel=1 corta a compilação JIT de nível
               mais caro: menos CPU e menos metadados de código para uma suíte curta. -->
          <argLine>-Xmx256m -XX:TieredStopAtLevel=1</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
